FROM node:22.14.0-alpine AS deps
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

FROM deps AS dev
WORKDIR /app/frontend
ENV NEXT_TELEMETRY_DISABLED=1
COPY frontend .
EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]

FROM node:22.14.0-alpine AS builder
WORKDIR /app/frontend
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/frontend/node_modules ./node_modules
COPY frontend .
RUN npm run build

FROM node:22.14.0-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    BACKEND_URL=http://127.0.0.1:8000 \
    INFERENCE_MODE=mock \
    PORT=3000 \
    HOSTNAME=0.0.0.0
RUN apk add --no-cache python3 \
    && python3 -m venv /opt/backend-venv \
    && addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs
COPY backend/requirements.txt ./backend/requirements.txt
RUN /opt/backend-venv/bin/python -m pip install --no-cache-dir -r backend/requirements.txt
COPY --from=builder --chown=nextjs:nodejs /app/frontend/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/frontend/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/frontend/.next/static ./.next/static
COPY --chown=nextjs:nodejs backend/__init__.py ./backend/__init__.py
COPY --chown=nextjs:nodejs backend/app ./backend/app
COPY --chown=nextjs:nodejs infra/docker/start-production.sh ./start-production.sh
RUN chmod +x ./start-production.sh
USER nextjs
EXPOSE 3000
CMD ["./start-production.sh"]
