# Next.js server -> FastAPI. Docker Compose overrides this with http://backend:8000.
BACKEND_URL=http://127.0.0.1:8000
BACKEND_TIMEOUT_MS=95000

# FastAPI inference provider: mock | local | runpod
INFERENCE_MODE=mock

# Server-only values used by FastAPI in runpod mode. Never prefix these with NEXT_PUBLIC_.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Optional: defaults to 90 seconds. Use async jobs for longer work.
RUNPOD_TIMEOUT_MS=90000
