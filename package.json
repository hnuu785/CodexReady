{
  "name": "codex-seoul-hackathon-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/with-env.sh npm --prefix frontend run dev",
    "dev:api": "python3 -m uvicorn backend.app.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "bash scripts/with-env.sh npm --prefix frontend run build",
    "start": "bash scripts/with-env.sh npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "test:web": "npm --prefix frontend run test",
    "test:api": "python3 -m pytest backend/tests",
    "test": "npm run test:web && npm run test:api",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down",
    "check": "bash scripts/check-readiness.sh",
    "deploy:aws": "bash scripts/deploy-aws.sh",
    "budget:aws": "bash scripts/setup-aws-budget.sh",
    "cleanup:aws": "bash scripts/cleanup-aws.sh"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
